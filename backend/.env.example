# MongoDB Connection
MONGODB_URI=mongodb://127.0.0.1:27017/skillgap

# JWT Secret — change this to a long random string in production
JWT_SECRET=skillgap_super_secret_jwt_key_here_2026

# Server Port
PORT=5000

# Frontend Origin URL
FRONTEND_URL=http://localhost:5173

# Groq API Key (for AI-powered resume skill extraction)
